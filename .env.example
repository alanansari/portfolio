# Sanity — get these from https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-06-01

# Optional: set to "true" to use Sanity's API CDN (faster reads; can show stale data briefly after publish/unpublish).
NEXT_PUBLIC_SANITY_USE_CDN=true

# GitHub — GITHUB_TOKEN is required for the *official* contribution calendar (GraphQL).
# Without it, the heatmap still tries public events (approximate). Create a PAT:
# github.com → Settings → Developer settings → Personal access tokens (read:user is enough).
GITHUB_USERNAME=alanansari
GITHUB_TOKEN=

# LeetCode — fallback if the LeetCode social URL in Sanity does not include /u/username
LEETCODE_USERNAME=_Alan_

# Web3Forms — used by the contact form (client-side)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# HCaptcha — used by the contact form (client-side)
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=50b2fe65-b00b-4b9e-ad62-3ba471098be2